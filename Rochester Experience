        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- TAB 1: BUILDER VIEW -->
        <div id="view-builder" class="space-y-8">

            <!-- Hero Section & Generator Controls -->
            <div class="gradient-bg rounded-3xl p-6 sm:p-10 text-white shadow-2xl relative overflow-hidden">
                <!-- Background visual elements -->
                <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute right-1/3 -top-10 w-48 h-48 bg-blue-500/10 rounded-full blur-2xl pointer-events-none"></div>

                <div class="relative z-10 max-w-3xl">
                    <span class="inline-block px-3 py-1 bg-sky-500/20 text-sky-300 rounded-full text-xs font-semibold uppercase tracking-wider mb-3 border border-sky-500/30">
                        MIS Capstone Solution
                    </span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">
                        Stop Browsing Options. Get Your All-In-One Rochester Package.
                    </h2>
                    <p class="text-slate-300 text-sm sm:text-base mb-8">
                        Instead of juggling separate hotel links, restaurant reviews, and activity listings, select your trip preferences below. We'll assemble a seamlessly matched, day-by-day Rochester care package.
                    </p>

                    <!-- Form Controls Grid -->
                    <form id="package-form" onsubmit="generatePackage(event)" class="bg-slate-900/80 p-5 sm:p-6 rounded-2xl border border-slate-700/60 backdrop-blur-md grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        
                        <!-- Duration -->
                        <div>
                            <label class="block text-xs font-medium text-slate-300 mb-1.5">
                                <i class="fa-solid fa-calendar-days text-sky-400 mr-1.5"></i>Stay Duration
                            </label>
                            <select id="param-days" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2.5 text-sm text-white focus:ring-2 focus:ring-sky-500 focus:outline-none">
                                <option value="1">1 Day (Quick Visit)</option>
                                <option value="2" selected>2 Days (Weekend Getaway)</option>
                                <option value="3">3 Days (Full Experience)</option>
                                <option value="4">4 Days (Deep Dive)</option>
                            </select>
                        </div>

                        <!-- Vibe / Persona -->
                        <div>
                            <label class="block text-xs font-medium text-slate-300 mb-1.5">
                                <i class="fa-solid fa-compass text-sky-400 mr-1.5"></i>Trip Theme & Vibe
                            </label>
                            <select id="param-vibe" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2.5 text-sm text-white focus:ring-2 focus:ring-sky-500 focus:outline-none">
                                <option value="family">Family & Fun</option>
                                <option value="foodie" selected>Foodie & Craft Drinks</option>
                                <option value="arts">Arts, Culture & History</option>
                                <option value="outdoors">Nature & Park Outdoors</option>
                                <option value="rit">RIT Parent / Student Visit</option>
                            </select>
                        </div>

                        <!-- Budget Level -->
                        <div>
                            <label class="block text-xs font-medium text-slate-300 mb-1.5">
                                <i class="fa-solid fa-wallet text-sky-400 mr-1.5"></i>Budget Preference
                            </label>
                            <select id="param-budget" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2.5 text-sm text-white focus:ring-2 focus:ring-sky-500 focus:outline-none">
                                <option value="budget">Value & Casual ($)</option>
                                <option value="moderate" selected>Balanced Comfort ($$)</option>
                                <option value="premium">Boutique & Fine Dining ($$$)</option>
                            </select>
                        </div>

                        <!-- Pace -->
                        <div>
                            <label class="block text-xs font-medium text-slate-300 mb-1.5">
                                <i class="fa-solid fa-gauge-high text-sky-400 mr-1.5"></i>Activity Pace
                            </label>
                            <select id="param-pace" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2.5 text-sm text-white focus:ring-2 focus:ring-sky-500 focus:outline-none">
                                <option value="relaxed">Relaxed (2-3 items/day)</option>
                                <option value="balanced" selected>Balanced (4 items/day)</option>
                                <option value="packed">Packed (5+ items/day)</option>
                            </select>
                        </div>

                        <!-- AI Special Request (Optional) -->
                        <div class="sm:col-span-2 lg:col-span-3">
                            <label class="block text-xs font-medium text-slate-300 mb-1.5">
                                <i class="fa-solid fa-sparkles text-amber-400 mr-1.5"></i>AI Customization Prompt (Optional)
                            </label>
                            <input type="text" id="param-custom" placeholder="e.g., Include local garbage plates, must be walkable, dog friendly, or kid friendly" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                        </div>

                        <!-- Submit Button -->
                        <div class="sm:col-span-2 lg:col-span-1 flex items-end">
                            <button type="submit" id="generate-btn" class="w-full bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold py-2.5 px-4 rounded-xl shadow-lg shadow-sky-500/20 transition flex items-center justify-center space-x-2">
                                <span>Build My Package</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Loading Indicator -->
            <div id="loading-spinner" class="hidden py-16 text-center">
                <div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-sky-500 border-t-transparent mb-4"></div>
                <h3 class="text-lg font-semibold text-slate-700">Curating Your Rochester Experience...</h3>
                <p class="text-sm text-slate-500 mt-1">Matching hotels, local dining, and top activities into a unified package.</p>
            </div>

            <!-- Generated Package Display Area -->
            <div id="package-results" class="hidden space-y-8">
                
                <!-- Package Summary Bar -->
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div>
                        <div class="flex items-center space-x-2 mb-1">
                            <span id="pkg-tag" class="px-2.5 py-0.5 rounded-md text-xs font-bold uppercase tracking-wider bg-sky-100 text-sky-800">
                                Curated Package
                            </span>
                            <span id="pkg-duration-badge" class="text-xs text-slate-500 font-medium"></span>
                        </div>
                        <h2 id="pkg-title" class="text-2xl font-bold text-slate-900"></h2>
                        <p id="pkg-description" class="text-slate-600 text-sm mt-1 max-w-3xl"></p>
                    </div>

                    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                        <button onclick="saveCurrentPackage()" id="save-btn" class="flex-1 md:flex-none px-4 py-2.5 border border-slate-300 rounded-xl text-slate-700 font-medium hover:bg-slate-50 transition flex items-center justify-center space-x-2">
                            <i class="fa-regular fa-bookmark"></i>
                            <span>Save Package</span>
                        </button>
                        <button onclick="printOrSharePackage()" class="flex-1 md:flex-none px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl font-medium transition flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-share-nodes"></i>
                            <span>Export / Share</span>
                        </button>
                    </div>
                </div>

                <!-- Hotel Recommendation Card (Core of the Care Package) -->
                <div class="bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200/80 rounded-2xl p-6 shadow-sm">
                    <div class="flex items-start justify-between flex-wrap gap-4">
                        <div class="flex items-start space-x-4">
                            <div class="w-12 h-12 rounded-xl bg-amber-500 text-white flex items-center justify-center text-xl shrink-0 shadow-md">
                                <i class="fa-solid fa-hotel"></i>
                            </div>
                            <div>
                                <div class="text-xs font-semibold text-amber-700 uppercase tracking-wider mb-0.5">Recommended Basecamp (Hotel)</div>
                                <h3 id="hotel-name" class="text-xl font-bold text-slate-900"></h3>
                                <p id="hotel-details" class="text-sm text-slate-600 mt-1"></p>
                                <div id="hotel-amenities" class="flex flex-wrap gap-2 mt-3"></div>
                            </div>
                        </div>
                        <div class="text-right">
                            <span id="hotel-price" class="text-lg font-bold text-slate-900 block"></span>
                            <span class="text-xs text-slate-500">Selected for proximity & vibe match</span>
                        </div>
                    </div>
                </div>

                <!-- Day-by-Day Experience Itinerary Timeline -->
                <div>
                    <h3 class="text-xl font-bold text-slate-900 mb-6 flex items-center">
                        <i class="fa-solid fa-route text-sky-600 mr-2.5"></i>
                        Your Day-by-Day Care Package Schedule
                    </h3>

                    <!-- Container for Days -->
                    <div id="days-container" class="space-y-8"></div>
                </div>

            </div>

        </div>

        <!-- TAB 2: SAVED PACKAGES VIEW -->
        <div id="view-saved" class="hidden space-y-6">
            <div class="flex items-center justify-between border-b border-slate-200 pb-4">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900">Saved Experience Packages</h2>
                    <p class="text-sm text-slate-500">Access your previously generated Rochester itineraries.</p>
                </div>
                <button onclick="clearSavedPackages()" class="text-xs text-red-600 hover:text-red-800 font-semibold flex items-center space-x-1">
                    <i class="fa-solid fa-trash"></i>
                    <span>Clear All Saved</span>
                </button>
            </div>

            <div id="saved-packages-list" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Dynamically populated -->
            </div>
            
            <div id="no-saved-state" class="text-center py-16 bg-white rounded-2xl border border-slate-200">
                <i class="fa-solid fa-folder-open text-4xl text-slate-300 mb-3"></i>
                <h3 class="text-lg font-semibold text-slate-700">No saved packages yet</h3>
                <p class="text-sm text-slate-500 mt-1">Use the Package Generator to build and save your custom Rochester trip!</p>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-6">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div>
                <strong>MIS Capstone Build Project</strong> — Rochester Care Package Builder Solution
            </div>
            <div class="flex items-center space-x-4">
                <span>RIT Campus & Rochester Region</span>
                <span>•</span>
                <span>Open Web-App Track</span>
            </div>
        </div>
    </footer>

    <!-- App Logic JavaScript -->
    <script>
        // -------------------------------------------------------------
        // ROCHESTER DATA REPOSITORY (Hotels, Dining, Activities)
        // -------------------------------------------------------------
        const ROC_HOTELS = [
            {
                id: 'hotel-1',
                name: 'The Strathallan Rochester Hotel & Spa - DoubleTree',
                vibe: ['foodie', 'premium', 'arts'],
                price: '$$$',
                address: '550 East Ave, Rochester, NY',
                desc: 'Upscale East Avenue hotel featuring the Char Steak & Lounge rooftop views and luxury amenities close to museums.',
                amenities: ['Rooftop Bar', 'Full Spa', 'East Ave Location', 'Pool']
            },
            {
                id: 'hotel-2',
                name: 'Courtyard by Marriott Rochester Downtown',
                vibe: ['foodie', 'moderate', 'family'],
                price: '$$',
                address: '390 East Ave, Rochester, NY',
                desc: 'Modern hotel in the heart of the Neighborhood of the Arts, walking distance to cafes and dining.',
                amenities: ['On-site Bistro', 'Free WiFi', 'Fitness Center', 'Central']
            },
            {
                id: 'hotel-3',
                name: 'Hilton Garden Inn Rochester University & Medical Center',
                vibe: ['rit', 'moderate', 'family'],
                price: '$$',
                address: '30 Celebration Dr, Rochester, NY',
                desc: 'Located in College Town, extremely convenient for visiting RIT, University of Rochester, and South Rochester.',
                amenities: ['College Town Access', 'Indoor Pool', 'Parking', 'Family Friendly']
            },
            {
                id: 'hotel-4',
                name: 'Hyatt Regency Rochester',
                vibe: ['arts', 'moderate', 'outdoors'],
                price: '$$',
                address: '125 E Main St, Rochester, NY',
                desc: 'High-rise downtown hotel with skyway connectivity, stunning Genesee River views, and central access.',
                amenities: ['River Views', 'Downtown Hub', 'Starbucks Onsite', 'Pool']
            },
            {
                id: 'hotel-5',
                name: 'Del Monte Lodge Renaissance Rochester Hotel & Spa',
                vibe: ['premium', 'outdoors', 'foodie'],
                price: '$$$',
                address: '41 N Main St, Pittsford, NY',
                desc: 'Luxury boutique hotel along the historic Erie Canal path in Pittsford, perfect for scenic strolls and fine dining.',
                amenities: ['Erie Canal View', 'Luxury Spa', 'Fine Dining', 'Boutique']
            }
        ];

        const ROC_ACTIVITIES = [
            // Family / Museum
            { name: 'The Strong National Museum of Play', type: 'Activity', vibe: ['family', 'arts'], cost: '$$', duration: '3-4 hrs', desc: 'World famous museum devoted to play, video games, giant arcade, and interactive exhibits.' },
            { name: 'Rochester Museum & Science Center (RMSC)', type: 'Activity', vibe: ['family', 'arts'], cost: '$', duration: '2 hrs', desc: 'Interactive science exhibits, planetarium shows, and local natural history.' },
            { name: 'Seneca Park Zoo', type: 'Activity', vibe: ['family', 'outdoors'], cost: '$', duration: '2-3 hrs', desc: 'Acclaimed zoo featuring African savanna exhibits, polar bears, and lush natural grounds along the river.' },
            
            // Arts & Culture
            { name: 'George Eastman Museum', type: 'Activity', vibe: ['arts', 'foodie'], cost: '$$', duration: '2-3 hrs', desc: 'The world’s oldest photography museum located inside the historic mansion of Kodak founder George Eastman.' },
            { name: 'Memorial Art Gallery (MAG)', type: 'Activity', vibe: ['arts'], cost: '$$', duration: '2 hrs', desc: '5,000 years of art history featuring world-class paintings, sculptures, and outdoor sculpture park.' },
            { name: 'High Falls & Genesee Brewery Terrace', type: 'Activity', vibe: ['outdoors', 'foodie', 'rit'], cost: '$', duration: '1.5 hrs', desc: 'View Rochester’s 96-foot downtown waterfall from the pedestrian bridge and brewery rooftop.' },
            
            // Outdoors & Parks
            { name: 'Highland Park & Lamberton Conservatory', type: 'Activity', vibe: ['outdoors', 'family', 'rit'], cost: '$', duration: '2 hrs', desc: 'Frederick Law Olmsted designed park famous for lilacs, historic arboretum, and glass greenhouse.' },
            { name: 'Ontario Beach Park & Historic Carousel', type: 'Activity', vibe: ['outdoors', 'family'], cost: '$', duration: '2 hrs', desc: 'Sandy Lake Ontario beach with pier walks and an authentic 1905 dentzel carousel.' },
            { name: 'Erie Canal Towpath Stroll (Pittsford Village)', type: 'Activity', vibe: ['outdoors', 'foodie'], cost: '$', duration: '1.5 hrs', desc: 'Picturesque canal path walk with boat watching, coffee shops, and ice cream.' },
            
            // Dining / Foodie
            { name: 'Nick Tahou Hots (Home of the Garbage Plate)', type: 'Dining', vibe: ['foodie', 'rit', 'family'], cost: '$', duration: '1 hr', desc: 'Rochester’s iconic culinary staple: home fries, mac salad, cheeseburgers topped with meat sauce.' },
            { name: 'Genesee Brew House', type: 'Dining', vibe: ['foodie', 'rit', 'outdoors'], cost: '$$', duration: '1.5 hrs', desc: 'Casual pub food and fresh craft beers with panoramic views of High Falls.' },
            { name: 'Fiorella (Public Market District)', type: 'Dining', vibe: ['foodie', 'premium'], cost: '$$$', duration: '1.5 hrs', desc: 'Farm-to-table artisanal Italian featuring handmade pasta and wood-fired pizzas.' },
            { name: 'Red Fern (Vegan & Local)', type: 'Dining', vibe: ['foodie', 'arts'], cost: '$$', duration: '1 hr', desc: 'Acclaimed plant-based comfort food, fresh juices, and scratch bakery goodies.' },
            { name: 'Dinosaur Bar-B-Que', type: 'Dining', vibe: ['foodie', 'family', 'rit'], cost: '$$', duration: '1.5 hrs', desc: 'Famous pit-barbecue served in a historic downtown building right along the river.' },
            { name: 'Pittsford Dairy', type: 'Dining', vibe: ['family', 'foodie', 'outdoors'], cost: '$', duration: '45 mins', desc: 'Legendary local bakery and creamery serving fresh soft-serve and rich ice cream.' },
            { name: 'Rohrbach Beer Hall', type: 'Dining', vibe: ['foodie', 'rit'], cost: '$$', duration: '1.5 hrs', desc: 'Rochester’s first craft brewery featuring wood-fired pizzas and local brews.' },

            // RIT specific
            { name: 'RIT Campus Tour & SHED Student Center', type: 'Activity', vibe: ['rit'], cost: 'Free', duration: '2 hrs', desc: 'Explore RIT’s vibrant brick campus, modern SHED maker spaces, and Tiger athletics.' },
            { name: 'Java’s Cafe (East Ave / Downtown)', type: 'Dining', vibe: ['rit', 'arts'], cost: '$', duration: '45 mins', desc: 'Classic bohemian coffee house known for eclectic vibe, fresh roast coffee, and pastries.' }
        ];

        // Current generated package state
        let currentPackage = null;

        // -------------------------------------------------------------
        // APPLICATION INITIALIZATION & TAB MANAGEMENT
        // -------------------------------------------------------------
        window.addEventListener('DOMContentLoaded', () => {
            updateSavedBadgeCount();
            // Auto generate initial package for demo
            document.getElementById('package-form').dispatchEvent(new Event('submit'));
        });

        function switchTab(tabName) {
            const builderView = document.getElementById('view-builder');
            const savedView = document.getElementById('view-saved');
            const btnBuilder = document.getElementById('tab-btn-builder');
            const btnSaved = document.getElementById('tab-btn-saved');

            if (tabName === 'builder') {
                builderView.classList.remove('hidden');
                savedView.classList.add('hidden');
                btnBuilder.className = "px-4 py-2 text-sm font-semibold rounded-lg bg-sky-600 text-white transition";
                btnSaved.className = "px-4 py-2 text-sm font-semibold rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition relative";
            } else {
                builderView.classList.add('hidden');
                savedView.classList.remove('hidden');
                btnSaved.className = "px-4 py-2 text-sm font-semibold rounded-lg bg-sky-600 text-white transition relative";
                btnBuilder.className = "px-4 py-2 text-sm font-semibold rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition";
                renderSavedPackages();
            }
        }

        // -------------------------------------------------------------
        // PACKAGE GENERATION LOGIC (MIS ALGORITHM)
        // -------------------------------------------------------------
        async function generatePackage(event) {
            if (event) event.preventDefault();

            const days = parseInt(document.getElementById('param-days').value);
            const vibe = document.getElementById('param-vibe').value;
            const budget = document.getElementById('param-budget').value;
            const pace = document.getElementById('param-pace').value;
            const customPrompt = document.getElementById('param-custom').value.trim();

            const spinner = document.getElementById('loading-spinner');
            const results = document.getElementById('package-results');
            
            spinner.classList.remove('hidden');
            results.classList.add('hidden');

            // Simulate algorithmic package curation & synthesis delay
            await new Promise(r => setTimeout(r, 600));

            // 1. Select Hotel (Basecamp)
            const matchedHotels = ROC_HOTELS.filter(h => h.vibe.includes(vibe)) || ROC_HOTELS;
            const selectedHotel = matchedHotels[Math.floor(Math.random() * matchedHotels.length)] || ROC_HOTELS[0];

            // 2. Select Activities & Dining aligned with Vibe
            let pool = ROC_ACTIVITIES.filter(act => act.vibe.includes(vibe) || act.vibe.includes('family'));
            if (pool.length < days * 3) {
                pool = [...ROC_ACTIVITIES]; // fallback to full list if pool small
            }

            // Shuffle pool
            pool = pool.sort(() => 0.5 - Math.random());

            // 3. Assemble Day-by-Day Schedule
            const itemsPerDay = pace === 'relaxed' ? 3 : (pace === 'balanced' ? 4 : 5);
            const itinerary = [];

            let itemIndex = 0;
            for (let d = 1; d <= days; d++) {
                const dayItems = [];
                
                // Morning Activity
                const morningAct = pool[itemIndex % pool.length];
                dayItems.push({ time: 'Morning (9:30 AM)', ...morningAct, category: 'Morning Highlight' });
                itemIndex++;

                // Lunch Spot
                const lunchSpot = pool.find(i => i.type === 'Dining') || ROC_ACTIVITIES.find(i => i.name.includes('Garbage Plate'));
                dayItems.push({ time: 'Lunch (12:30 PM)', ...lunchSpot, category: 'Midday Dining' });

                // Afternoon Activity
                const afternoonAct = pool[(itemIndex + 1) % pool.length];
                dayItems.push({ time: 'Afternoon (2:30 PM)', ...afternoonAct, category: 'Afternoon Discovery' });
                itemIndex += 2;

                // Evening Dinner/Drinks (if pace calls for it)
                if (itemsPerDay >= 4) {
                    const dinnerSpot = pool.find(i => i.type === 'Dining' && i.name !== lunchSpot.name) || pool[0];
                    dayItems.push({ time: 'Evening (6:30 PM)', ...dinnerSpot, category: 'Evening Dinner & Vibe' });
                }

                itinerary.push({ dayNumber: d, items: dayItems });
            }

            // 4. Construct Package Object
            const vibeTitles = {
                family: 'Family Fun & Play Package',
                foodie: 'Culinary & Craft Brews Experience',
                arts: 'Arts, Heritage & Culture Trail',
                outdoors: 'Parks, Waterfalls & Scenic Rochester',
                rit: 'RIT Visitor & Campus Explorer Package'
            };

            currentPackage = {
                id: 'pkg_' + Date.now(),
                title: `${days}-Day ${vibeTitles[vibe]}`,
                vibe: vibe,
                duration: `${days} ${days === 1 ? 'Day' : 'Days'}`,
                budget: budget,
                hotel: selectedHotel,
                itinerary: itinerary,
                createdAt: new Date().toLocaleDateString(),
                customNote: customPrompt ? `Tailored for: "${customPrompt}"` : null
            };

            // 5. Render Package to Screen
            displayPackage(currentPackage);

            spinner.classList.add('hidden');
            results.classList.remove('hidden');
        }

        function displayPackage(pkg) {
            document.getElementById('pkg-title').textContent = pkg.title;
            document.getElementById('pkg-tag').textContent = `${pkg.vibe.toUpperCase()} EXPERIENCE`;
            document.getElementById('pkg-duration-badge').textContent = `• ${pkg.duration} Curated Package`;
            
            const desc = `Your complete Rochester package includes hotel accommodations at ${pkg.hotel.name}, coupled with a pre-arranged schedule of iconic local activities and meals.`;
            document.getElementById('pkg-description').textContent = pkg.customNote ? `${desc} (${pkg.customNote})` : desc;

            // Hotel display
            document.getElementById('hotel-name').textContent = pkg.hotel.name;
            document.getElementById('hotel-details').textContent = `${pkg.hotel.address} — ${pkg.hotel.desc}`;
            document.getElementById('hotel-price').textContent = pkg.hotel.price;
            
            const amenitiesContainer = document.getElementById('hotel-amenities');
            amenitiesContainer.innerHTML = pkg.hotel.amenities.map(a => `
                <span class="px-2.5 py-1 bg-white border border-amber-200 text-amber-900 rounded-lg text-xs font-semibold">
                    <i class="fa-solid fa-check text-amber-600 mr-1"></i>${a}
                </span>
            `).join('');

            // Days timeline display
            const daysContainer = document.getElementById('days-container');
            daysContainer.innerHTML = '';

            pkg.itinerary.forEach(day => {
                const dayEl = document.createElement('div');
                dayEl.className = "bg-white border border-slate-200 rounded-2xl p-6 shadow-sm";
                
                let itemsHtml = day.items.map((item, idx) => `
                    <div class="relative pl-6 border-l-2 border-sky-400 pb-6 last:pb-0">
                        <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-sky-500 border-2 border-white shadow"></div>
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
                            <span class="text-xs font-bold text-sky-700 uppercase tracking-wider">${item.time} — ${item.category}</span>
                            <span class="text-xs font-medium text-slate-500"><i class="fa-solid fa-clock text-slate-400 mr-1"></i>Est. ${item.duration}</span>
                        </div>
                        <h4 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                            ${item.type === 'Dining' ? '<i class="fa-solid fa-utensils text-orange-500 text-sm"></i>' : '<i class="fa-solid fa-location-dot text-sky-500 text-sm"></i>'}
                            ${item.name}
                        </h4>
                        <p class="text-sm text-slate-600 mt-1">${item.desc}</p>
                    </div>
                `).join('');

                dayEl.innerHTML = `
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
                        <h4 class="text-lg font-extrabold text-slate-900 flex items-center">
                            <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-800 flex items-center justify-center font-bold text-sm mr-3">D${day.dayNumber}</span>
                            Day ${day.dayNumber} Schedule
                        </h4>
                        <span class="text-xs font-medium text-slate-500">Care Package Itinerary</span>
                    </div>
                    <div class="space-y-4">
                        ${itemsHtml}
                    </div>
                `;

                daysContainer.appendChild(dayEl);
            });
        }

        // -------------------------------------------------------------
        // SAVED PACKAGES / LOCAL STORAGE LOGIC
        // -------------------------------------------------------------
        function getSavedPackages() {
            try {
                return JSON.parse(localStorage.getItem('roc_saved_packages') || '[]');
            } catch (e) {
                return [];
            }
        }

        function saveCurrentPackage() {
            if (!currentPackage) return;

            let saved = getSavedPackages();
            if (saved.some(p => p.id === currentPackage.id)) {
                alert('This package is already saved!');
                return;
            }

            saved.push(currentPackage);
            try {
                localStorage.setItem('roc_saved_packages', JSON.stringify(saved));
                updateSavedBadgeCount();
                alert('Package successfully saved to your collection!');
            } catch (e) {
                alert('Unable to save package to browser storage.');
            }
        }

        function updateSavedBadgeCount() {
            const saved = getSavedPackages();
            const badge = document.getElementById('saved-badge');
            if (saved.length > 0) {
                badge.textContent = saved.length;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        function renderSavedPackages() {
            const saved = getSavedPackages();
            const container = document.getElementById('saved-packages-list');
            const emptyState = document.getElementById('no-saved-state');

            container.innerHTML = '';

            if (saved.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            saved.forEach(pkg => {
                const card = document.createElement('div');
                card.className = "bg-white border border-slate-200 rounded-2xl p-6 shadow-sm card-hover flex flex-col justify-between";
                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="px-2 py-0.5 rounded text-xs font-bold bg-sky-100 text-sky-800 uppercase">${pkg.vibe}</span>
                            <span class="text-xs text-slate-400">${pkg.createdAt}</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-1">${pkg.title}</h3>
                        <p class="text-xs text-slate-500 mb-4"><i class="fa-solid fa-hotel text-amber-500 mr-1"></i>Hotel: ${pkg.hotel.name}</p>
                        
                        <div class="text-xs text-slate-600 bg-slate-50 p-3 rounded-xl border border-slate-100 mb-4">
                            <strong>Includes:</strong> ${pkg.itinerary.length} Day Schedule with ${pkg.itinerary.reduce((acc, d) => acc + d.items.length, 0)} curated spots.
                        </div>
                    </div>

                    <div class="flex items-center space-x-3 border-t border-slate-100 pt-4">
                        <button onclick="loadSavedPackage('${pkg.id}')" class="flex-1 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-bold transition">
                            View Package
                        </button>
                        <button onclick="deleteSavedPackage('${pkg.id}')" class="px-3 py-2 border border-slate-200 text-slate-500 hover:text-red-600 hover:bg-slate-50 rounded-lg text-xs transition">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function loadSavedPackage(id) {
            const saved = getSavedPackages();
            const found = saved.find(p => p.id === id);
            if (found) {
                currentPackage = found;
                displayPackage(found);
                switchTab('builder');
                document.getElementById('package-results').classList.remove('hidden');
            }
        }

        function deleteSavedPackage(id) {
            let saved = getSavedPackages();
            saved = saved.filter(p => p.id !== id);
            localStorage.setItem('roc_saved_packages', JSON.stringify(saved));
            updateSavedBadgeCount();
            renderSavedPackages();
        }

        function clearSavedPackages() {
            if (confirm('Are you sure you want to clear all saved packages?')) {
                localStorage.removeItem('roc_saved_packages');
                updateSavedBadgeCount();
                renderSavedPackages();
            }
        }

        function printOrSharePackage() {
            window.print();
        }
    </script>
</body>
</html>
